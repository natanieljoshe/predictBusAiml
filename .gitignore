# --- Machine Learning / Data Science Project Specifics ---

# Data (Ignore typical data file extensions to avoid committing large datasets)
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.h5
*.hdf5
*.db
*.sqlite
data/*
!data/.gitkeep

# Models (Ignore trained models)
*.pkl
*.pt
*.pth
*.joblib
*.pb
*.onnx
models/*
!models/.gitkeep

# Outputs (Ignore output files and logs)
outputs/*
!outputs/.gitkeep
logs/
*.log
